{
  "name": "sam-benish-portfolio",
  "version": "1.0.0",
  "description": "Premium Personal Portfolio Website - Sam Benish",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
