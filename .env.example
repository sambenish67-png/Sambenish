# Environment variables for the portfolio application

# Add your email service configuration here if needed
# VITE_EMAIL_SERVICE_KEY=your_key_here

# Endpoint the contact form posts to. When unset the submission is simulated
# and a warning is logged instead of silently pretending it succeeded.
# VITE_CONTACT_ENDPOINT=https://example.com/api/contact

